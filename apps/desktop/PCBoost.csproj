<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ximbuismo</AssemblyName>
    <RootNamespace>PCBoost</RootNamespace>
    <Product>Ximbuismo</Product>
    <Title>Ximbuismo</Title>
    <ApplicationIcon>Assets/Ximbuismo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Endereço do servidor oficial gravado no app: dotnet publish -p:TeamServerUrl=https://seu-servidor -->
    <TeamServerUrl Condition="'$(TeamServerUrl)' == ''">http://localhost:5080</TeamServerUrl>
    <!-- Repositório do GitHub cujas releases o app consulta para se atualizar: -p:UpdateRepo=dono/repo -->
    <UpdateRepo Condition="'$(UpdateRepo)' == ''">Raidoxxx/probable-app</UpdateRepo>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Ximbuismo.ico" />
    <AssemblyMetadata Include="TeamServer" Value="$(TeamServerUrl)" />
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\packages\shared\PCBoost.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
